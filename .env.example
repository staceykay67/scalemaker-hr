# Formspree form IDs (or full https://formspree.io/f/... URLs).
# These IDs send to staceykay@scalemakerhr.com. They are public form
# endpoints, not secrets, but keep them out of application source.
#
# Add the same variables in Vercel → scalemaker-hr → Settings →
# Environment Variables (Production + Preview), then redeploy.

FORMSPREE_CONTACT_ID=xjyvrwad
FORMSPREE_ASSESSMENT_ID=xyeyjwbz

# Equivalent public names (also supported):
# NEXT_PUBLIC_FORMSPREE_CONTACT=xjyvrwad
# NEXT_PUBLIC_FORMSPREE_ASSESSMENT=xyeyjwbz
#
# Optional: one shared form instead of two. Used only when the matching
# specific variable above is empty. Submissions include formType = contact | assessment.
# FORMSPREE_FORM_ID=

# Assessment lead rate limit (server-side, by IP, /api/leads only).
# After this many successful assessment posts, that IP cools down.
# Contact form (/api/contact) is not limited by these settings.
# ASSESSMENT_RATE_LIMIT_MAX=3
# ASSESSMENT_RATE_LIMIT_WINDOW_HOURS=24

# Durable store for Vercel (recommended in production). Create a free
# Upstash Redis database, or enable Vercel KV / Upstash Redis in the
# Vercel project, then add the REST credentials:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Equivalent Vercel KV names are also accepted:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#
# Without Redis, the API falls back to in-memory counts. That is fine
# for local `npm run dev`, but on Vercel each serverless instance has
# its own memory, so the limit will not be reliable until Redis is set.
# ASSESSMENT_RATE_LIMIT_STORE=memory
