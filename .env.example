# Formspree form IDs (or full https://formspree.io/f/... URLs).
# These IDs send to staceykay@scalemakerhr.com. They are public form
# endpoints, not secrets, but keep them out of application source.
#
# Add the same variables in Vercel → scalemaker-hr → Settings →
# Environment Variables (Production + Preview), then redeploy.

FORMSPREE_CONTACT_ID=xjyvrwad
FORMSPREE_ASSESSMENT_ID=xyeyjwbz

# Equivalent public names (also supported):
# NEXT_PUBLIC_FORMSPREE_CONTACT=xjyvrwad
# NEXT_PUBLIC_FORMSPREE_ASSESSMENT=xyeyjwbz
#
# Optional: one shared form instead of two. Used only when the matching
# specific variable above is empty. Submissions include formType = contact | assessment.
# FORMSPREE_FORM_ID=
