# Formspree form IDs (or full https://formspree.io/f/... URLs).
# Create the forms in Formspree so submissions email staceykay@scalemakerhr.com,
# then add these in Vercel → Project → Settings → Environment Variables
# and redeploy. Form IDs are not secrets, but they should not be committed.

NEXT_PUBLIC_FORMSPREE_CONTACT=
NEXT_PUBLIC_FORMSPREE_ASSESSMENT=

# Optional: one shared Formspree form instead of two.
# Used only when the matching specific variable above is empty.
# Submissions include formType = contact | assessment.
# NEXT_PUBLIC_FORMSPREE_FORM=
